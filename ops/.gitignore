# 原始資料快照不進版控 —— 每日抓的 CSV 加起來 ~500KB,天天 commit 會把 repo 撐爆。
# 心跳改用 data/manifest.json(小、且記錄了來源與 sha256,有稽核價值)。
data/raw/*.csv

# package-lock.json 刻意【不】忽略 —— CI 用 npm ci 需要它才能重現安裝。
__pycache__/
*.pyc
.pytest_cache/
.coverage
node_modules/

# 這兩個檔由每日健檢維護,住在 ops-data 分支(見 .github/workflows/daily-health.yml)。
# 留在 main 會變成永遠停在某次執行的過期值,比沒有更誤導。
data/manifest.json
data/health_log.csv
# 同理:體制訊號每日重算,留在 main 會是一份永遠停在某次執行的假現況。
# workflow 用 `git add -f` 推到 ops-data,不受這裡影響。
data/signals.json

# PWA 讀的資料鏡像,同理 —— 每日重新產生,只住在 ops-data。
# 留在 main 的話 PWA 會有兩份來源,而使用者讀到哪一份取決於網址,不取決於程式。
data/pwa/

# 依賴安裝的稽核軌跡,同理 —— 每次執行重新產生,只住在 ops-data。
# ⚠ 它必須被忽略:心跳用 `git add -f` 推它,而留在 main 的那一份會是「某次
# 在誰的機器上跑出來的版本組合」,而這整層存在的理由就是歸因。
# 一份過期的歸因資料比沒有更誤導。
data/deps/

# 年度報告由 annual-review.yml 產生並推到 ops-data 分支,同理不留在 main。
reports/
