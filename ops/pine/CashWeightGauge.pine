//@version=5
// =============================================================================
//  現金水位儀 · Cash-Weight Gauge
//  趨勢動能 × 真實 VIX 聯集策略 — 建議現金比重 0–100%
//
//  ⚠ 必須套用在【月線 1M】圖表上。
//    所有滾動窗口(SMA12 / z36 / spike6)的單位都是「月」,套在日線或週線上
//    長度會全錯。圖表非月線時,右上角資訊表會變成紅色警告。
//
//  ⚠ 建議套用在 SP:SPX(或 SPY / ES1!)上,策略是為美國大盤設計的。
//
//  ⚠ 這份實作必須與 ops/src/engine.py 完全一致 —— engine.py 是真理來源。
//
//    邏輯層已自動驗證:ops/tests/pine_sim.py 會從【本檔原始碼】解析常數與階梯,
//    用 Pine 的語義重現計算後與 engine.py 逐月比對,CI 每次都跑。
//    所以改動下面任何一個數字,測試都會失敗 —— 那是刻意的。
//
//    執行層仍需人工:把本指標的 cash 序列從 TradingView 匯出成 CSV,執行
//        python ops/scripts/check_pine_parity.py <匯出的.csv>
//    差異 > 1e-9 即視為漂移。在跑過之前,本檔算「邏輯已驗證、執行未驗證」。
// =============================================================================
indicator("現金水位儀 · Cash-Weight Gauge", shorttitle="CWG", overlay=false, precision=1)

// ---- 參數 -------------------------------------------------------------------
vixSym   = input.symbol("CBOE:VIX", "VIX 來源", tooltip="歷史較長的替代來源:TVC:VIX")
showLegs = input.bool(true, "顯示兩腿分解")

// 以下常數與 engine.py 逐字對應,不是可調參數 —— 它們是已回測定案的值。
// 想做敏感度分析請用 ops/src/annual_review.py,不要在這裡改。
MOM_LEN   = 12      // SMA12:動能腿的均線長度
Z_LEN     = 36      // z-score 回看月數
SPIKE_LEN = 6       // 飆升項回看月數
VIX_BASE  = 16.0    // 水位項基準
VIX_DIV   = 9.0     // 水位項除數
SPIKE_DIV = 12.0    // 飆升項除數
W_LVL     = 0.55    // 水位權重
W_Z       = 0.30    // z-score 權重
W_SPIKE   = 0.15    // 飆升權重

// ---- 樣本標準差(ddof=1)-----------------------------------------------------
// Pine 內建的 ta.stdev() 是【母體】標準差(除以 n),engine.py 用的是
// pandas 的【樣本】標準差(除以 n-1)。直接用 ta.stdev 會讓 z-score 系統性偏大,
// 進而讓 VIX 腿在邊界附近多拉現金。這裡手算,除以 (n-1)。
sampleStdev(float src, int len) =>
    m = ta.sma(src, len)
    float ss = na
    if not na(m)
        ss := 0.0
        for i = 0 to len - 1
            ss += math.pow(src[i] - m, 2)
    na(ss) ? na : math.sqrt(ss / (len - 1))

// ---- 階梯函式 ---------------------------------------------------------------
// 注意兩條階梯的門檻方向不同:動能腿用嚴格小於、VIX 腿用嚴格大於。
// 這是刻意對齊 engine.py 的語意,不是筆誤。
momCash(float m) =>
    float c = 0.0
    if not na(m)
        if m < 0.0
            c := 0.30
        if m < -0.03
            c := 0.60
        if m < -0.08
            c := 0.90
        if m < -0.13
            c := 1.00
    c

vixCash(float r) =>
    float c = 0.0
    if not na(r)
        if r > 0.5
            c := 0.24
        if r > 1.0
            c := 0.42
        if r > 1.8
            c := 0.66
        if r > 2.6
            c := 0.90
        if r > 3.4
            c := 1.00
    c

// ---- 資料 -------------------------------------------------------------------
// 只需要 VIX 的月收與月內最高。已驗證風險分數不使用月均與月交易日數,
// 所以月K的 close / high 就足以精確重現 engine.py,不需任何近似。
vixC = request.security(vixSym, timeframe.period, close, lookahead=barmerge.lookahead_off)
vixH = request.security(vixSym, timeframe.period, high,  lookahead=barmerge.lookahead_off)

// ---- VIX 領先腿 -------------------------------------------------------------
lvl = math.max((vixC - VIX_BASE) / VIX_DIV, 0.0)

m36  = ta.sma(vixC, Z_LEN)
sd36 = sampleStdev(vixC, Z_LEN)
// 暖機期(不足 36 個月)與零變異時都取 0,與 engine.py 一致
z = (not na(sd36) and sd36 > 0.0) ? (vixC - m36) / sd36 : 0.0

m6 = ta.sma(vixC, SPIKE_LEN)
// 飆升項必須「整式補 0」,不能只把滾動均值補 0 —— 否則會變成 (high-0)/12,是完全不同的數
spike = not na(m6) ? (vixH - m6) / SPIKE_DIV : 0.0

risk = W_LVL * math.max(lvl, 0.0) + W_Z * math.max(z, 0.0) + W_SPIKE * math.max(spike, 0.0)

// ---- 趨勢動能腿 -------------------------------------------------------------
sma12 = ta.sma(close, MOM_LEN)
mom   = na(sma12) ? na : close / sma12 - 1.0

// ---- 聯集 -------------------------------------------------------------------
mc   = momCash(mom)
vc   = vixCash(risk)
cash = math.max(mc, vc)

// 暖機期沒有有效訊號,不要畫成 0%(那會被誤讀成「建議滿倉」)
hasSignal = not na(sma12) and not na(vixC)
cashPct   = hasSignal ? cash * 100.0 : na

// ---- 繪圖 -------------------------------------------------------------------
levelColor(float c) =>
    c >= 1.00 ? #F43F5E :
      c >= 0.66 ? #FB923C :
      c >= 0.42 ? #FBBF24 :
      c >  0.0  ? #FBBF24 : #2DD4BF

plot(cashPct, "建議現金比重%", color=levelColor(cash), linewidth=2, style=plot.style_stepline)
plot(showLegs and hasSignal ? mc * 100.0 : na, "趨勢動能腿%",
     color=color.new(#8A9CB8, 25), linewidth=1, style=plot.style_stepline)
plot(showLegs and hasSignal ? vc * 100.0 : na, "VIX領先腿%",
     color=color.new(#2DD4BF, 25), linewidth=1, style=plot.style_stepline)

// 階梯刻度:上排是 VIX 腿的門檻,下排標出動能腿獨有的 30/60
hline(100, "100", color=color.new(color.red,    60), linestyle=hline.style_dotted)
hline(90,  "90",  color=color.new(color.orange, 70), linestyle=hline.style_dotted)
hline(66,  "66",  color=color.new(color.orange, 80), linestyle=hline.style_dotted)
hline(60,  "60",  color=color.new(color.gray,   85), linestyle=hline.style_dotted)
hline(42,  "42",  color=color.new(color.yellow, 80), linestyle=hline.style_dotted)
hline(30,  "30",  color=color.new(color.gray,   85), linestyle=hline.style_dotted)
hline(24,  "24",  color=color.new(color.yellow, 85), linestyle=hline.style_dotted)
hline(0,   "0",   color=color.new(color.gray,   70))

// ---- 資訊表 -----------------------------------------------------------------
var table info = table.new(position.top_right, 2, 6, border_width=1)

if barstate.islast
    bool wrongTf = timeframe.period != "1M"
    bgHead = wrongTf ? color.new(color.red, 0) : color.new(#16223A, 0)
    txtHead = wrongTf ? "⚠ 請切換到月線 1M" : "現金水位儀"

    table.cell(info, 0, 0, txtHead, text_color=color.white, bgcolor=bgHead)
    table.cell(info, 1, 0, wrongTf ? timeframe.period : "月線",
               text_color=color.white, bgcolor=bgHead)

    table.cell(info, 0, 1, "建議現金", text_color=#8A9CB8)
    table.cell(info, 1, 1, str.tostring(cash * 100, "#.#") + "%",
               text_color=levelColor(cash))

    table.cell(info, 0, 2, "趨勢動能腿", text_color=#8A9CB8)
    table.cell(info, 1, 2, str.tostring(mc * 100, "#.#") + "%", text_color=#E8EEF7)

    table.cell(info, 0, 3, "VIX 領先腿", text_color=#8A9CB8)
    table.cell(info, 1, 3, str.tostring(vc * 100, "#.#") + "%", text_color=#E8EEF7)

    table.cell(info, 0, 4, "乖離 (對 MA12)", text_color=#8A9CB8)
    table.cell(info, 1, 4, str.tostring(mom * 100, "+#.##") + "%", text_color=#E8EEF7)

    table.cell(info, 0, 5, "VIX 風險分數", text_color=#8A9CB8)
    table.cell(info, 1, 5, str.tostring(risk, "#.###"), text_color=#E8EEF7)

// ---- 匯出用 -----------------------------------------------------------------
// TradingView 的「匯出圖表資料」會把所有 plot 一併輸出。
// check_pine_parity.py 只讀「建議現金比重%」這一欄,其餘欄位存在不影響比對。
